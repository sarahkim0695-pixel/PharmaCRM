{
  "name": "repmap",
  "private": true,
  "version": "1.0.0",
  "description": "RepMap – Gebietskarte, Praxen, Besuche und Produkte für den Außendienst (PWA, offline-fähig)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "plz:fetch": "tsx scripts/fetch-plz.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "mapshaper": "^0.7.101",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
